{
  "name": "orchestration",
  "version": "0.1.0",
  "description": "A local to-do system that agents can read, claim, and report progress to.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "orchestration": "./bin/orchestration",
    "orch": "./bin/orchestration"
  },
  "types": "./lib/sdk.d.ts",
  "exports": {
    ".": {
      "types": "./lib/sdk.d.ts",
      "import": "./lib/sdk.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "import": "./lib/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "lib"
  ],
  "scripts": {
    "orchestration": "node ./bin/orchestration",
    "dev": "node ./scripts/dev.mjs",
    "dev:web": "vite",
    "build": "vite build && npm run build:sdk",
    "build:sdk": "tsc src/sdk.ts --outDir lib --rootDir src --declaration --target ES2023 --module NodeNext --moduleResolution NodeNext --rewriteRelativeImportExtensions --erasableSyntaxOnly --verbatimModuleSyntax --strict --skipLibCheck --esModuleInterop --types node",
    "prepare": "npm run build:sdk",
    "pretest": "npm run build:sdk",
    "pretypecheck": "npm run build:sdk",
    "start": "node ./bin/orchestration ui",
    "test": "node --disable-warning=ExperimentalWarning --test --test-force-exit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "chrono-node": "^2.7.7",
    "cron-parser": "^5.7.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
